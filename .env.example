# Copie este arquivo para .env.local e preencha com os dados de Connect > App Frameworks no Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Só para `pnpm cerebro:sync` (roda no seu Mac, nunca vai para o navegador).
# Service role em Project Settings > API Keys. Nunca prefixar com VITE_.
SUPABASE_SERVICE_ROLE_KEY=
# Pasta do vault, se não for a padrão (~/Documents/FRT CEREBRO).
# CEREBRO_VAULT=
# E-mail do dono, só quando o projeto tiver mais de um usuário.
# CEREBRO_OWNER_EMAIL=
